# Environment
NODE_ENV=dev

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # for Socket Mode
SLACK_ALERT_CHANNEL=C012AB3CD         # channel ID for Alertmanager alerts
SLACK_ONCALL_USERS=U012AB3CD,U098ZY7WX  # comma-separated Slack user IDs
# Who may approve/reject remediations (falls back to SLACK_ONCALL_USERS)
# SLACK_APPROVER_USERS=U012AB3CD
# Emoji that triggers learn-from-thread when reacted inside an investigated thread
# (needs reactions:read scope + reaction_added event subscription)
# SLACK_LEARN_REACTION=white_check_mark

# Shared secret required on POST /alert (Authorization: Bearer <token>). Unset leaves the
# webhook open and logs a warning at startup. Set the same value on the Alertmanager side
# under http_config.authorization.credentials.
# ALERT_WEBHOOK_TOKEN=

# GitOps PR-flow remediation (DESIGN_gitops_pr_remediation.md). When true, a Flux
# HelmRelease-managed workload's remediation opens a PR via the llm-worker (which holds the
# GitHub App creds) instead of being refused. The agent holds NO GitHub credentials.
# GITOPS_REMEDIATION_ENABLED=true
# SQS_GITOPS_REQUEST_QUEUE_NAME=gitops-request.fifo   # must match the worker
# SQS_GITOPS_TIMEOUT_SECONDS=120

PORT=3000

# LLM Provider: claude | openai-compatible | private-llm | router
LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-4-8
# Output token ceiling (claude + openai-compatible). Default 8096.
# MAX_TOKENS=8096

# Private LLM via SQS (event-driven, for strict private network)
# LLM_PROVIDER=private-llm
# AWS_REGION=ap-southeast-1
# SQS_REQUEST_QUEUE_NAME=llm-request.fifo
# SQS_RESPONSE_QUEUE_NAME=llm-response.fifo
# SQS_LLM_TIMEOUT_SECONDS=240
# SQS_POLL_WAIT_SECONDS=10
#
# AWS credentials — only needed for local dev, not required when using IRSA on EKS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # optional, for temporary credentials
# OPENAI_COMPATIBLE_BASE_URL=http://your-llm-server/v1
# OPENAI_COMPATIBLE_API_KEY=your-api-key
# OPENAI_COMPATIBLE_MODEL=your-model-name

# LLM Router — hold several backends and pick one per call: light for plain Slack mentions,
# heavy for alerts, investigations and remediation proposals. Failover is up-only (a light
# backend that fails escalates into heavy and stays there; heavy never drops to light).
# Indices must be contiguous from 1; _KIND is claude | openai-compatible | private-llm, and
# only private-llm takes the SQS path. Everything below is validated at boot — a typo is a
# pod that won't start, not a failed alert. Keep the _KEY values in a Secret.
# LLM_PROVIDER=router
# LLM_BACKEND_1_NAME=local
# LLM_BACKEND_1_KIND=private-llm
# LLM_BACKEND_2_NAME=opus
# LLM_BACKEND_2_KIND=claude
# LLM_BACKEND_2_MODEL=claude-opus-4-8
# LLM_BACKEND_2_KEY=your-anthropic-api-key
# LLM_ROUTE_LIGHT=local        # optional
# LLM_ROUTE_HEAVY=opus         # required; comma-separated = ordered failover chain

# MCP Server
# Transport: stdio | http
MCP_TRANSPORT=stdio
MCP_STDIO_COMMAND=node
MCP_STDIO_ARGS=../devops-mcp-server/dist/index.js
# MCP_HTTP_URL=http://localhost:3001/mcp
# Bearer token for the MCP server (http transport). Must match the server's MCP_AUTH_TOKEN.
# MCP_AUTH_TOKEN=
# Per-tool-call timeout in seconds (a hung MCP server/upstream can't stall an investigation)
# MCP_TOOL_TIMEOUT_SECONDS=45

# Wall-clock budget per investigation in seconds (bounds how long a concurrency slot is held)
# INVESTIGATION_TIMEOUT_SECONDS=300

# Tool-call rounds allowed for a plain Slack mention (each round batches parallel calls).
# Explicit investigation requests and alerts are uncapped. Budget resets per message.
# MENTION_TOOL_ROUNDS=2

# Post-remediation verification (durable, claimed by any replica — not an in-process timer).
# The delay must outlast a rolling update, or a half-converged workload reads as "not fixed".
# REMEDIATION_VERIFY_DELAY_SECONDS=300
# REMEDIATION_VERIFY_POLL_SECONDS=30

# Missed-resolved reconciliation. Alertmanager sends a resolved notification once and never
# repeats it, and /alert acks 200 before processing — so one failure leaves the incident
# reading as firing AND holds its dedup claim, which suppresses the alert's next real firing.
# The sweeper asks Alertmanager directly instead of waiting for a POST that is never resent.
# INCIDENT_RECONCILE_ENABLED=true
# INCIDENT_RECONCILE_MIN_AGE_SECONDS=600
# INCIDENT_RECONCILE_CONFIRM_SECONDS=120
# INCIDENT_RECONCILE_BATCH=50

# Conversation Memory
# MEMORY_BACKEND: inmemory (default, lost on restart) | redis (persistent)
MEMORY_BACKEND=inmemory

# Redis — required only when MEMORY_BACKEND=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password
# REDIS_TLS=false

# Incident Memory (durable, learns from past RCAs) — disabled unless DB_HOST is set.
# Distinct from conversation memory above: this is a long-lived record, not a cache.
# The incidents table is created automatically on startup.
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=devops_agent
# DB_USERNAME=devops_agent
# DB_PASSWORD=your-db-password
# DB_SSL_MODE=disable          # disable | require | verify-full

# Concurrency
# MAX_CONCURRENT_INVESTIGATIONS=5

# Log level: error | warn | info | http | debug (default: debug in dev, info in prod)
# LOG_LEVEL=info

# AWS Auth Mode: iam-anywhere | irsa | env | instance-profile (default: iam-anywhere)
# AWS_AUTH_MODE=irsa
#
# Required only for iam-anywhere:
# AWS_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:...
# AWS_ROLESANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:...
# AWS_ROLE_ARN=arn:aws:iam::123456789:role/your-role
# CERT_PATH=/certs/tls.crt
# CERT_KEY_PATH=/certs/tls.key

# Read-only incident dashboard, served on its own port inside the agent process.
# Access control is two locks, not one: a shared-password session (below) AND the fact
# that this port is not routed by the Ingress. Keep both — the password is what makes an
# accidental route survivable, not a licence to add one.
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3001
# Required when DASHBOARD_ENABLED=true — the dashboard serves 503 until it is set, rather
# than serving incident history anonymously. In Kubernetes this comes from a Secret via
# secretKeyRef, never from a ConfigMap. Rotating it signs everyone out, by design.
DASHBOARD_PASSWORD=
# Set to false ONLY when reaching the dashboard over plain HTTP on a hostname (a browser
# treats localhost as secure, so a port-forward does not need this). A Secure cookie sent
# over plain HTTP is dropped silently and the login page simply reappears forever.
# DASHBOARD_COOKIE_SECURE=true
