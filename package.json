{
  "name": "devops-ai-agent",
  "version": "1.0.0",
  "description": "DevOps AI Agent for RCA and incident response via Slack",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "migrate": "node --import tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/src/db/migrate-cli.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@aws-sdk/client-sqs": "3.1058.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.3",
    "dotenv": "16.5.0",
    "ioredis": "^5.6.1",
    "openai": "4.103.0",
    "pg": "^8.22.0",
    "winston": "3.17.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
