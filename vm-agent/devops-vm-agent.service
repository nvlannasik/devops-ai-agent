[Unit]
Description=devops-vm-agent — pulls approved restarts from the devops agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/devops-vm-agent.py /etc/devops-vm-agent.conf
Restart=always
RestartSec=10
# Root, because `systemctl restart` of an arbitrary unit needs it; what may be restarted is limited
# by `units` in the config, which only root can edit (0600).
User=root

[Install]
WantedBy=multi-user.target
