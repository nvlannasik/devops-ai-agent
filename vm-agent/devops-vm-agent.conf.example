[agent]
# Must match a name in the agent's VM_AGENT_TOKENS, and the `hostname` label this VM's telemetry carries.
name = vm-web-01
# https:// for anything beyond a lab (the agent's Ingress path /vm/). http:// works and logs a warning.
url = https://agent.annasik.cloud
token = <this VM's token from VM_AGENT_TOKENS>
# The ONLY units the agent may ever ask this VM to restart. Anything else is refused here.
units = nginx.service orders.service
# Units whose journal the agent may READ (version 5). Default: kubelet, containerd, etcd + `units`.
# journal_units = kubelet.service containerd.service etcd.service nginx.service
poll_seconds = 10
# ca_file = /etc/ssl/certs/internal-ca.pem
# A Kubernetes node: its cluster (as the agent's MCP_LOCAL_CLUSTER / MCP_*_CLUSTERS names it) and its
# node name there. Leave both out on a host outside any cluster — it is listed as standalone.
# The node name defaults to `name`; set it when `name` differs (two clusters with a node `worker1`).
# cluster = dev
# node = worker1
