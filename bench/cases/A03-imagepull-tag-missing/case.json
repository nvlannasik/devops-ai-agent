{
  "id": "A03-imagepull-tag-missing",
  "tier": "A",
  "title": "ImagePullBackOff, tag does not exist",
  "settleSeconds": 20,
  "groupLabels": { "alertname": "KubernetesPodImagePullFailing", "namespace": "bench-a03", "severity": "critical" },
  "alerts": [
    {
      "labels": { "alertname": "KubernetesPodImagePullFailing", "namespace": "bench-a03", "container": "web", "severity": "critical" },
