{
  "id": "A16-pending-node-left-cordoned",
  "tier": "A",
  "title": "Pod Pending because the only node it may run on was left cordoned",
  "settleSeconds": 15,
  "groupLabels": { "alertname": "KubernetesPodNotScheduled", "namespace": "bench-a16", "severity": "warning", "cluster": "dev" },
  "alerts": [
    {
      "labels": { "alertname": "KubernetesPodNotScheduled", "namespace": "bench-a16", "severity": "warning", "cluster": "dev" },
      "annotations": {
        "summary": "Pod in bench-a16 has been Pending for 10 minutes",
        "description": "A pod in namespace `bench-a16` is `Pending` and has not been scheduled onto any node."
      }
    }
  ],
  "expect": {
    "action": "k8s_uncordon",
    "target": "worker3-vm",
    "rca": {
      "must": ["cordon|unschedulable|schedulingdisabled|tidak bisa dijadwalkan", "worker3-vm"],
      "mustNot": ["insufficient (cpu|memory)|kekurangan (cpu|memori)", "(memory|disk|pid) ?pressure"]
    }
  }
}
